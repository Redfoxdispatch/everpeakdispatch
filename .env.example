# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.

# Supabase Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Project Settings -> Data API -> service_role (server-only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Project Settings -> Database -> Connection string
# Use the "Transaction pooler" URL for DATABASE_URL — used by both the app's
# runtime Prisma client AND the Prisma CLI (migrate/studio). The true direct
# connection (db.<ref>.supabase.co) is IPv6-only unless your project has
# Supabase's IPv4 add-on, so it fails outright on most home/office networks —
# don't route anything through it. DIRECT_URL is currently unused (kept for
# future use / if you have the IPv4 add-on) — set it to the "Session pooler"
# URL if you fill it in at all, not the raw direct connection.
# If your DB password contains special characters (@, :, /, etc.), percent-encode them.
DATABASE_URL=
DIRECT_URL=

# Any long random string. Authorizes app/api/cron/* — Vercel Cron sends this
# automatically as "Authorization: Bearer <value>" once set in your Vercel
# project's env vars (this exact name is Vercel's own convention). Generate
# with e.g. `openssl rand -hex 32`.
CRON_SECRET=
